{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL", "FORWARD_SECRET", "VERCEL"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "//#lint:e2e": { "inputs": ["e2e/**", "playwright.config.ts", "eslint.config.js"] },
    "//#typecheck:e2e": {
      "inputs": [
        "e2e/**",
        "playwright.config.ts",
        "tsconfig.e2e.json",
        "tsconfig.base.json",
        "apps/web/messages/**",
        "apps/web/lib/**",
        "packages/*/src/**"
      ]
    },
    "test": { "outputs": [] },
    "generate": { "cache": false },
    "migrate": { "cache": false },
    "seed": { "cache": false }
  }
}
