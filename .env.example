# --- api ---
NODE_ENV=development
PORT=4000
# Postgres connection used by the API, migrations and the seed. Compose overrides the host to "postgres".
DATABASE_URL=postgres://tabletap:tabletap@localhost:5432/tabletap
# better-auth: at least 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789
# Public URL of the API (cookie prefix + callback base).
BETTER_AUTH_URL=http://localhost:4000
# Browser origin of the web app; used for CORS and better-auth trustedOrigins.
WEB_ORIGIN=http://localhost:3000
# Signs the tt_guest cookie (@fastify/cookie). At least 32 chars.
COOKIE_SECRET=dev-cookie-secret-change-me-0123456789abcdef
# Signs the table token inside QR codes (HS256). At least 32 chars.
TABLE_TOKEN_SECRET=dev-table-token-secret-change-me-0123456789
# Signs the short-lived Socket.io handshake token (HS256). At least 32 chars, different from the table secret.
SOCKET_TOKEN_SECRET=dev-socket-token-secret-change-me-0123456789
# Printed QR codes must outlive demo resets: token lifetime in days. Seed ids are derived from
# natural keys, so a reset keeps the same table ids and a printed code keeps working (ADR 0002).
TABLE_TOKEN_TTL_DAYS=365
# Guest session lifetime (sliding) in hours.
GUEST_SESSION_TTL_HOURS=4
# pino level: fatal error warn info debug trace silent
LOG_LEVEL=info
# Comma-separated list of trusted proxy addresses/CIDRs or the keywords loopback, linklocal,
# uniquelocal; x-forwarded-for is honoured only from these.
TRUST_PROXY=loopback,uniquelocal
# Password for the three seeded staff accounts.
DEMO_PASSWORD=tabletap-demo
# Demo mode: exposes GET /api/demo/links and resets the seed on an interval (0 disables the reset).
DEMO_MODE=true
DEMO_RESET_INTERVAL_MINUTES=60
# Refuses new menu photo uploads while leaving every other admin action alone (spec §2): a public
# demo visitor may do anything an admin can except put an object in storage the hourly reset does
# not undo. This value is the control and the API enforces it; NEXT_PUBLIC_UPLOADS_ENABLED below is
# only the web's explanation of the same decision, so if the two ever disagree a visitor sees a
# button that fails politely rather than a hole. True here so the local Compose demo keeps taking
# uploads as M5 built and verified it; the public deployment sets this to false (docs/deploy.md).
DEMO_UPLOADS_ENABLED=true
# Set true behind HTTPS. Defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=false

# --- payments ---
# Leave both empty to run the demo provider: the guest pays on an in-app terminal, no card and no
# money, and the demo routes exist only in that mode. Set both to run Stripe Checkout in test mode.
# Locally, forward events with: stripe listen --forward-to localhost:4000/api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- object storage (menu photographs) ---
# Locally this is MinIO: docker compose brings it up on 9000 (S3 API) and 9001 (console, signed in
# with the two keys below), creates the bucket and opens its menu/ prefix to anonymous readers.
# That prefix is world-readable on purpose - a guest scans a QR code and gets no session, so the
# photographs have to be public; nothing else in the bucket is. Blanking the four required ones
# runs the API without photographs instead of failing to start - though only for host development:
# under docker compose the api service sets them itself, so blanking them here changes nothing.
# For AWS S3: S3_ENDPOINT=https://s3.<region>.amazonaws.com, S3_FORCE_PATH_STYLE=false and
# S3_PUBLIC_URL=https://<bucket>.s3.<region>.amazonaws.com (or the CloudFront domain).
# For Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, path style true, and
# S3_PUBLIC_URL set to the bucket's public r2.dev or custom domain.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tabletap
S3_ACCESS_KEY_ID=tabletap
S3_SECRET_ACCESS_KEY=tabletap-secret
# The origin an upload URL is signed for. SigV4 covers the Host header, so this has to be the
# origin the *browser* will PUT to. Leave it unset when that is the endpoint above, as it is here;
# compose sets it to http://localhost:9000, because there the API dials MinIO at http://minio:9000.
# Not the same thing as S3_PUBLIC_URL, which may be a read-only CDN that accepts no uploads.
# S3_PRESIGN_ENDPOINT=
# Base URL the browser reads a photograph from; unset, the endpoint and the bucket stand in for it.
S3_PUBLIC_URL=http://localhost:9000/tabletap
S3_FORCE_PATH_STYLE=true

# --- web ---
# Server-side rewrite target for /api/* (build-time in Next.js). Compose passes http://api:4000 as a build arg.
API_URL=http://localhost:4000
# Browser-facing API origin for the Socket.io connection (build-time, like every NEXT_PUBLIC_*).
# Compose passes http://localhost:4000 as a build arg; production points at the public API host.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The web's explanation of DEMO_UPLOADS_ENABLED above, not the control - the API enforces the
# refusal on its own value regardless of what this was built with. Keep it matched to
# DEMO_UPLOADS_ENABLED by hand; being NEXT_PUBLIC_*, it is inlined into the JS bundle at build time
# (Dockerfile.web passes it as a build arg), not read at container start like the API's variables.
NEXT_PUBLIC_UPLOADS_ENABLED=true

# --- postgres (docker compose) ---
POSTGRES_USER=tabletap
POSTGRES_PASSWORD=tabletap
POSTGRES_DB=tabletap
