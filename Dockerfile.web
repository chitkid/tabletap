FROM node:24-alpine AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG API_URL=http://api:4000
# The browser opens the Socket.io connection itself, so this origin has to be the one a browser
# on the host can reach, not the Compose network name — and NEXT_PUBLIC_* is inlined at build
# time, so it has to be here rather than in the runner stage.
ARG NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Absolute URLs in the link preview (metadataBase, apps/web/app/layout.tsx). Also read again at
# runtime by dynamically rendered routes — the runner stage's own ENV covers that half; this one
# is what the two routes Next prerenders here at build time (/session-ended, /_not-found) get
# baked with. Missing this ARG was a real defect: docker-compose.yml passed the variable only as a
# runtime value, so those two pages always rendered with http://localhost:3000 baked in.
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
# The web's explanation of DEMO_UPLOADS_ENABLED, not the control — see
# apps/web/components/admin/photo-field.tsx. Client-only, so unlike NEXT_PUBLIC_APP_URL it needs
# no runtime counterpart in the runner stage below.
ARG NEXT_PUBLIC_UPLOADS_ENABLED=true
ENV API_URL=$API_URL NEXT_PUBLIC_API_ORIGIN=$NEXT_PUBLIC_API_ORIGIN \
  NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL NEXT_PUBLIC_UPLOADS_ENABLED=$NEXT_PUBLIC_UPLOADS_ENABLED \
  NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN pnpm tokens && pnpm --filter @tabletap/web build

FROM node:24-alpine AS runner
# The rewrite target is baked into the build above; the server components read API_URL again at
# request time, so the runtime must carry the same value or every server-side read falls back to
# localhost:4000, which is nothing inside this container.
ARG API_URL=http://api:4000
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 API_URL=$API_URL
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
USER node
CMD ["node", "apps/web/server.js"]
