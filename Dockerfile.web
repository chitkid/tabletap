FROM node:24-alpine AS base
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG API_URL=http://api:4000
# The browser opens the Socket.io connection itself, so this origin has to be the one a browser
# on the host can reach, not the Compose network name — and NEXT_PUBLIC_* is inlined at build
# time, so it has to be here rather than in the runner stage.
ARG NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
ENV API_URL=$API_URL NEXT_PUBLIC_API_ORIGIN=$NEXT_PUBLIC_API_ORIGIN NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN pnpm tokens && pnpm --filter @tabletap/web build

FROM node:24-alpine AS runner
# The rewrite target is baked into the build above; the server components read API_URL again at
# request time, so the runtime must carry the same value or every server-side read falls back to
# localhost:4000, which is nothing inside this container.
ARG API_URL=http://api:4000
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 API_URL=$API_URL
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
